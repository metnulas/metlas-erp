generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[]
  orders    Order[]
  products  Product[]
  stockMovements StockMovement[]
  vehicles  Vehicle[]
  personnel Personnel[]
}

model Customer {
  id                 String    @id @default(cuid())
  tenantId           String
  customerCode       String
  fullName           String
  phone              String
  phone2             String?
  email              String?
  address            String?   @db.Text
  city               String?
  district           String?
  location           String?
  balance            Decimal   @default(0) @db.Decimal(14, 2)
  depositBottleCount Int       @default(0)
  emptyBottleCount   Int       @default(0)
  isActive           Boolean   @default(true)
  notes              String?   @db.Text
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders             Order[]

  @@unique([tenantId, customerCode])
  @@index([tenantId, fullName])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERING
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  tenantId      String
  orderCode     String
  customerId    String
  orderDate     DateTime    @default(now())
  deliveryDate  DateTime?
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @default(0) @db.Decimal(14, 2)
  discount      Decimal     @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal     @default(0) @db.Decimal(14, 2)
  notes         String?     @db.Text
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]

  @@unique([tenantId, orderCode])
  @@index([tenantId, orderDate])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, deletedAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @default(0) @db.Decimal(14, 2)
  notes       String? @db.Text
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Product {
  id             String          @id @default(cuid())
  tenantId       String
  code           String
  name           String
  category       String?
  unit           String          @default("ADET")
  description    String?         @db.Text
  salePrice      Decimal         @default(0) @db.Decimal(14, 2)
  purchasePrice  Decimal         @default(0) @db.Decimal(14, 2)
  stockQuantity  Int             @default(0)
  minStockLevel  Int             @default(0)
  hasDeposit     Boolean         @default(false)
  depositAmount  Decimal         @default(0) @db.Decimal(14, 2)
  isActive       Boolean         @default(true)
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  ORDER
  RETURN
  ADJUSTMENT
}

model StockMovement {
  id            String            @id @default(cuid())
  tenantId      String
  productId     String
  type          StockMovementType
  quantity      Int
  balanceAfter  Int
  referenceType String?
  referenceId   String?
  notes         String?           @db.Text
  createdBy     String?
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, type])
  @@index([referenceType, referenceId])
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id             String        @id @default(cuid())
  tenantId       String
  code           String
  plate          String
  type           String
  brand          String?
  model          String?
  modelYear      Int?
  capacity       Int           @default(0)
  capacityUnit   String        @default("ADET")
  mileage        Int           @default(0)
  status         VehicleStatus @default(ACTIVE)
  inspectionDate DateTime?
  insuranceDate  DateTime?
  notes          String?       @db.Text
  isActive       Boolean       @default(true)
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, code])
  @@unique([tenantId, plate])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}

enum PersonnelStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Personnel {
  id                 String          @id @default(cuid())
  tenantId           String
  employeeCode       String
  fullName           String
  phone              String
  email              String?
  position           String
  licenseNumber      String?
  licenseClass       String?
  licenseExpiryDate  DateTime?
  hireDate           DateTime?
  status             PersonnelStatus @default(ACTIVE)
  notes              String?         @db.Text
  isActive           Boolean         @default(true)
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, employeeCode])
  @@index([tenantId, fullName])
  @@index([tenantId, position])
  @@index([tenantId, status])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}
