generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  customers Customer[]
  orders    Order[]
  products  Product[]
  stockMovements StockMovement[]
  vehicles  Vehicle[]
  personnel Personnel[]
  users     User[]
  roles     Role[]
  permissionGroups PermissionGroup[]
  permissions Permission[]
  userRoles UserRole[]
  rolePermissions RolePermission[]
  orderSequence OrderSequence?
  auditLogs AuditLog[]
  customerAccountEntries CustomerAccountEntry[]
  routeHistories RouteHistory[]
}

enum LegacyUserRole {
  ADMIN
  OPERATIONS
  COURIER
  ACCOUNTING
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  email        String   @unique
  name         String
  passwordHash String
  role         LegacyUserRole @default(OPERATIONS)
  permissionVersion Int @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roleAssignments UserRole[]

  @@index([tenantId, isActive])
  @@index([tenantId, role])
}

model PermissionGroup {
  id          String   @id @default(cuid())
  tenantId    String?
  key         String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions  Permission[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive, deletedAt])
}

model Permission {
  id          String   @id @default(cuid())
  tenantId    String?
  groupId     String
  key         String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  group       PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]

  @@unique([tenantId, key])
  @@index([groupId, isActive, deletedAt])
  @@index([tenantId, isActive, deletedAt])
}

model Role {
  id           String   @id @default(cuid())
  tenantId     String?
  key          String
  name         String
  description  String?
  color        String?
  icon         String?
  isSystem     Boolean  @default(false)
  isSuperAdmin Boolean  @default(false)
  isActive     Boolean  @default(true)
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]
  permissions  RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive, deletedAt])
  @@index([isSuperAdmin, isActive])
}

model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String?
  roleId       String
  permissionId String
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, roleId, permissionId])
  @@index([roleId, deletedAt])
  @@index([permissionId, deletedAt])
}

model UserRole {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String
  roleId     String
  deletedAt  DateTime?
  assignedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId])
  @@index([userId, deletedAt])
  @@index([roleId, deletedAt])
}

model OrderSequence {
  tenantId  String   @id
  nextValue Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId, createdAt])
}

model Customer {
  id                 String    @id @default(cuid())
  tenantId           String
  customerCode       String
  fullName           String
  phone              String
  phone2             String?
  email              String?
  address            String?   @db.Text
  city               String?
  district           String?
  location           String?
  latitude           Float?
  longitude          Float?
  balance            Decimal   @default(0) @db.Decimal(14, 2)
  depositBottleCount Int       @default(0)
  emptyBottleCount   Int       @default(0)
  isActive           Boolean   @default(true)
  notes              String?   @db.Text
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orders             Order[]
  accountEntries     CustomerAccountEntry[]

  @@unique([tenantId, customerCode])
  @@index([tenantId, fullName])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}

enum CustomerAccountEntryType {
  CHARGE
  PAYMENT
  DEPOSIT_IN
  DEPOSIT_OUT
}

model CustomerAccountEntry {
  id                 String                    @id @default(cuid())
  tenantId           String
  customerId         String
  type               CustomerAccountEntryType
  amount             Decimal                   @default(0) @db.Decimal(14, 2)
  balanceAfter       Decimal                   @default(0) @db.Decimal(14, 2)
  depositChange      Int                       @default(0)
  depositBalanceAfter Int                      @default(0)
  referenceType      String?
  referenceId        String?
  notes              String?                   @db.Text
  createdBy          String?
  createdAt          DateTime                  @default(now())
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer           Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([referenceType, referenceId])
}

model RouteHistory {
  id                    String   @id @default(cuid())
  tenantId              String
  routeDate             DateTime @db.Date
  distanceKm            Float    @default(0)
  estimatedFuelLiters   Float    @default(0)
  fuelPricePerLiter     Decimal  @default(0) @db.Decimal(14, 2)
  estimatedFuelCost     Decimal  @default(0) @db.Decimal(14, 2)
  revenue               Decimal  @default(0) @db.Decimal(14, 2)
  orderCount            Int      @default(0)
  stops                 Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, routeDate])
  @@index([tenantId, routeDate])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERING
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  tenantId      String
  orderCode     String
  customerId    String
  orderDate     DateTime    @default(now())
  deliveryDate  DateTime?
  status        OrderStatus @default(PENDING)
  totalAmount   Decimal     @default(0) @db.Decimal(14, 2)
  discount      Decimal     @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal     @default(0) @db.Decimal(14, 2)
  notes         String?     @db.Text
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  vehicle       Vehicle?    @relation("OrderVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  personnel     Personnel?  @relation("OrderPersonnel", fields: [personnelId], references: [id], onDelete: SetNull)
  vehicleId     String?
  personnelId   String?
  deliveryNotes String?      @db.Text
  deliveredAt   DateTime?

  @@unique([tenantId, orderCode])
  @@index([tenantId, orderDate])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, personnelId])
  @@index([tenantId, deliveryDate])
  @@index([tenantId, deletedAt])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(14, 2)
  total       Decimal @default(0) @db.Decimal(14, 2)
  notes       String? @db.Text
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model Product {
  id             String          @id @default(cuid())
  tenantId       String
  code           String
  name           String
  category       String?
  unit           String          @default("ADET")
  description    String?         @db.Text
  salePrice      Decimal         @default(0) @db.Decimal(14, 2)
  purchasePrice  Decimal         @default(0) @db.Decimal(14, 2)
  stockQuantity  Int             @default(0)
  minStockLevel  Int             @default(0)
  hasDeposit     Boolean         @default(false)
  depositAmount  Decimal         @default(0) @db.Decimal(14, 2)
  isActive       Boolean         @default(true)
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, category])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  ORDER
  RETURN
  ADJUSTMENT
}

model StockMovement {
  id            String            @id @default(cuid())
  tenantId      String
  productId     String
  type          StockMovementType
  quantity      Int
  balanceAfter  Int
  referenceType String?
  referenceId   String?
  notes         String?           @db.Text
  createdBy     String?
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, type])
  @@index([referenceType, referenceId])
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Vehicle {
  id             String        @id @default(cuid())
  tenantId       String
  code           String
  plate          String
  type           String
  brand          String?
  model          String?
  modelYear      Int?
  capacity       Int           @default(0)
  capacityUnit   String        @default("ADET")
  mileage        Int           @default(0)
  status         VehicleStatus @default(ACTIVE)
  inspectionDate DateTime?
  insuranceDate  DateTime?
  notes          String?       @db.Text
  isActive       Boolean       @default(true)
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedOrders Order[]       @relation("OrderVehicle")

  @@unique([tenantId, code])
  @@unique([tenantId, plate])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}

enum PersonnelStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Personnel {
  id                 String          @id @default(cuid())
  tenantId           String
  employeeCode       String
  fullName           String
  phone              String
  email              String?
  position           String
  licenseNumber      String?
  licenseClass       String?
  licenseExpiryDate  DateTime?
  hireDate           DateTime?
  status             PersonnelStatus @default(ACTIVE)
  notes              String?         @db.Text
  isActive           Boolean         @default(true)
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedOrders     Order[]         @relation("OrderPersonnel")

  @@unique([tenantId, employeeCode])
  @@index([tenantId, fullName])
  @@index([tenantId, position])
  @@index([tenantId, status])
  @@index([tenantId, isActive])
  @@index([tenantId, deletedAt])
}
